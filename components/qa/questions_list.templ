package qa

templ QuestionList(questions []QuestionViewModel) {
	<div id="unapproved-questions-container" class="h-full">
		if len(questions) == 0 {
			<div class="h-full w-full flex justify-center items-center">
				<h1 class="text-2xl font-semibold">No questions for you :(</h1>
			</div>
		} else {
			<h2 class="my-2 text-xl font-semibold">Questions</h2>
			for _, q := range questions {
				@Question(q)
			}
		}
	</div>
}
